# LLM Provider (Gemini is the default; use GEMINI_API_KEY or GOOGLE_API_KEY)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FAST_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30.0

# Optional Groq alternative (set LLM_PROVIDER=groq to use it)
GROQ_API_KEY=your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
FAST_LLM_MODEL=llama-3.3-70b-versatile

# Embedding & Vector Database
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
GEMINI_EMBEDDING_DIMENSIONS=768
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_DIR=data/chroma
CHROMA_COLLECTION=fastapi_docs_gemini2_qa_v1

# Persistence & Storage
DB_PATH=data/app.db
DOCS_DIR=data/docs
MANIFEST_PATH=data/corpus_manifest.json

# RAG Workflow Parameters
MAX_RETRIES=2
TOP_K=5
GRADING_CONCURRENCY=3
CHUNK_SIZE=200
CHUNK_OVERLAP=35

# Optional public web fallback (only after indexed corpus retries are exhausted)
WEB_SEARCH_ENABLED=false
TAVILY_API_KEY=
WEB_SEARCH_MAX_RESULTS=5

# API Constraints
MAX_QUESTION_LENGTH=1000
MAX_UPLOAD_SIZE_BYTES=5242880

# Express Analytics - RAG Technical Documentation Assistant
# Environment Configuration Template

# ----------------------------------------------------
# LLM Provider Configuration (Pick your preferred provider)
# ----------------------------------------------------
# Options: openai, groq, google, anthropic
DEFAULT_LLM_PROVIDER=openai
DEFAULT_MODEL_NAME=gpt-4o-mini

# API Keys (Set the one corresponding to your provider)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----------------------------------------------------
# Embedding & Vector Store Configuration
# ----------------------------------------------------
# Options: text-embedding-3-small, sentence-transformers/all-MiniLM-L6-v2, etc.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL_NAME=text-embedding-3-small
VECTOR_STORE_TYPE=chroma
CHROMA_PERSIST_DIRECTORY=./chroma_db
CHROMA_COLLECTION_NAME=tech_docs

# Ingestion Chunking Configuration
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# ----------------------------------------------------
# LangGraph Workflow Settings
# ----------------------------------------------------
MAX_RETRIES=2
SIMILARITY_TOP_K=4
ENABLE_WEB_SEARCH_FALLBACK=false
ENABLE_HALLUCINATION_CHECK=true

# Web Search API (Optional bonus fallback: Tavily)
TAVILY_API_KEY=your_tavily_api_key_here

# ----------------------------------------------------
# LangSmith Observability & Tracing
# ----------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=express-rag-assistant

# ----------------------------------------------------
# FastAPI Server Settings
# ----------------------------------------------------
HOST=0.0.0.0
PORT=8000
DEBUG=true
